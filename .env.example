# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebasedatabase.app
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Discord Webhooks
CONTACT_WEBHOOK_URL=your_contact_webhook_url
TICKETS_WEBHOOK_URL=your_tickets_webhook_url

# Security Notes:
# - Never commit the actual .env file to git
# - Add .env to .gitignore
# - For GitHub Pages, use GitHub Secrets and a build step
# - For Cloudflare Pages, use environment variables in dashboard
